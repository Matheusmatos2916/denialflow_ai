# DenialFlow AI — environment (copy to .env)



# LLM provider: groq | openai

LLM_PROVIDER=groq



# Groq — chat/agents only (CrewAI + fallbacks). Does NOT provide embeddings.

GROQ_API_KEY=gsk_...

# Automatic fallback order: PRIMARY → FALLBACK → APPEAL (deduped).
# Use bare ids (llama-3.3-70b-versatile) or provider/id (openai/gpt-oss-120b) for Groq-hosted models.
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile

GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

GROQ_MODEL_APPEAL=llama-3.3-70b-versatile



# OpenAI — REQUIRED for embeddings/RAG even when LLM_PROVIDER=groq.
# Optional for chat when LLM_PROVIDER=openai.

OPENAI_API_KEY=sk-...

OPENAI_MODEL_PRIMARY=gpt-4o-mini

OPENAI_MODEL_FALLBACK=gpt-4o-mini

OPENAI_MODEL_APPEAL=gpt-4o-mini

OPENAI_EMBEDDING_MODEL=text-embedding-3-small



# API

API_HOST=0.0.0.0

API_PORT=8000



# Paths (relative to cwd)

DATABASE_PATH=data/denialflow.db

CHROMA_PERSIST_DIR=./data/chroma

SEED_DOCUMENTS_DIR=./data/seed_documents



# Workflow

WORKFLOW_TOKEN_BUDGET=120000

CLASSIFICATION_CACHE_TTL_SECONDS=3600



# Amazon Bedrock — second opinion: 1st-opinion draft + RAG docs from Chroma/embeddings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # optional, for temporary credentials
BEDROCK_MODEL_REVIEW=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_REVIEW_ENABLED=true
BEDROCK_REVIEW_MAX_TOKENS=300
# LiteLLM direct call (default). Set true only if you need CrewAI agent wrapper (more tokens/retries)
BEDROCK_REVIEW_USE_CREWAI=false
# When true, second opinion uses Groq only (Bedrock is skipped; also used on quota/throttle)
BEDROCK_REVIEW_FALLBACK_GROQ=false
# RAG for 2nd opinion: uses citations_json on appeal by default; refresh re-queries Chroma
BEDROCK_REVIEW_RAG_REFRESH=false
BEDROCK_REVIEW_RAG_TOP_K=6
BEDROCK_REVIEW_RAG_SNIPPET_CHARS=800

# Gmail API — notify on human approve/edit
# Personal Gmail: OAuth client JSON in GMAIL_SERVICE_ACCOUNT_FILE + run scripts/gmail_authorize.py
# Workspace: service account JSON + domain-wide delegation
GMAIL_NOTIFY_ENABLED=false
GMAIL_SERVICE_ACCOUNT_FILE=gcp/key_gmail.json
GMAIL_OAUTH_TOKEN_FILE=gcp/gmail_token.json
GMAIL_IMPERSONATE_USER=testescursor46@gmail.com
GMAIL_TO=testescursor46@gmail.com
GMAIL_FAIL_ON_ERROR=false

# API authentication (static Bearer token — no login endpoint)
# Generate: python scripts/generate_api_token.py
JWT_AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
API_ACCESS_TOKEN=

# AgentOps — LLM/agent observability (optional; leave key empty to disable)
# https://docs.agentops.ai/v2/integrations/crewai
AGENTOPS_API_KEY=
AGENTOPS_ENABLED=true
AGENTOPS_PROJECT_TAGS=denialflow,poc
# AGENTOPS_LOG_LEVEL=DEBUG

# Streamlit client

DENIALFLOW_API_BASE=http://127.0.0.1:8000
API_ACCESS_TOKEN=

